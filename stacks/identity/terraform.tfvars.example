aws_profile              = "default"
aws_region               = "us-east-1"
environment              = "dev"
tenant_slug              = "replace-with-aws-tenant-slug"
entra_tenant_id          = "replace-with-entra-directory-tenant-id"
gwchat_bff_client_id     = "replace-with-bff-application-client-id"
agent_api_client_id      = "replace-with-agent-api-application-client-id"
m365_mcp_client_id       = "replace-with-m365-mcp-application-client-id"

